<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <title>Login</title>

  <link rel="stylesheet" href="css/login.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body class="login-bg">
  <div class="login-card">

    <img src="/image/project logo.png" class="logo">

    <h2 class="title">
      ระบบจัดการคลังชิ้นเนื้อโคขุน
    </h2>

    <p class="subtitle">
      กรุณาเข้าสู่ระบบเพื่อจัดการคลังชิ้นเนื้อ
    </p>

    <form class="login-form" id="loginForm">
      <p id="errorMsg" class="error" style="display:none;"></p>

      <div class="form-group">
        <label>ชื่อผู้ใช้ :</label>
        <input type="text" name="username" placeholder="กรุณากรอกชื่อผู้ใช้">
      </div>

      <div class="form-group">
        <label>รหัสผ่าน :</label>
        <input type="password" name="password" placeholder="กรุณากรอกรหัสผ่าน">
      </div>


      <button type="submit" class="login-btn">Sign In</button>

      <div class="login-links">
        <a href="#" class="open-modal" data-target="registerModal">สมัครสมาชิก</a>
        <a href="#" class="open-modal" data-target="forgetpassModal">ลืมรหัสผ่าน?</a>
      </div>
    </form>
  </div>

  <div id="registerModal" class="modal hidden">
    <div class="modal-card">
      <h3 class="modal-title">สมัครสมาชิก</h3>
      <h2 class="modal-subtitle">กรุณากรอกข้อมูลเพื่อสมัครสมาชิก</h2>

      <form class="modal-form" action="/user/register" method="POST" enctype="multipart/form-data">

        <!-- USERNAME -->
        <div class="form-regis-group">
          <label>ชื่อผู้ใช้ ( Username )</label>
          <input type="text" name="username" required>
        </div>

        <!-- PASSWORD -->
        <div class="form-regis-group">
          <label>รหัสผ่าน ( Password )</label>
          <input type="password" name="password" required>
        </div>

        <!-- ชื่อ / นามสกุล -->
        <div class="form-regis-row">
          <div class="form-regis-group">
            <label>ชื่อ</label>
            <input type="text" name="firstname" required>
          </div>

          <div class="form-regis-group">
            <label>นามสกุล</label>
            <input type="text" name="lastname" required>
          </div>
        </div>

        <!-- วันเกิด -->
        <div class="form-regis-group">
          <label>วันเกิด</label>
          <input type="date" name="birthday" required>
        </div>

        <!-- เพศ -->
        <div class="form-regis-group">
          <label>เพศ</label>
          <select name="gender_id" required>
            <option value="" disabled selected>เลือกเพศ</option>
            <option value="1">ชาย</option>
            <option value="2">หญิง</option>
            <option value="3">ไม่ระบุ</option>
          </select>
        </div>

        <!-- เลขบัตร -->
        <div class="form-regis-group">
          <label>เลขบัตรประชาชน</label>
          <input type="text" name="citizen_id" maxlength="13">
        </div>

        <!-- สัญชาติ -->
        <div class="form-regis-group">
          <label>สัญชาติ</label>
          <input type="text" name="nation">
        </div>

        <!-- ที่อยู่ -->
        <div class="form-regis-group">
          <label>ที่อยู่</label>
          <input type="text" name="address">
        </div>

        <!-- เบอร์ / อีเมล -->
        <div class="form-regis-row">
          <div class="form-regis-group">
            <label>เบอร์โทรศัพท์</label>
            <input type="tel" name="tel_main">
          </div>

          <div class="form-regis-group">
            <label>อีเมล</label>
            <input type="email" name="email">
          </div>
        </div>

        <!-- เบอร์สำรอง -->
        <div class="form-regis-group">
          <label>เบอร์โทรศัพท์สำรอง</label>
          <input type="tel" name="tel_sub">
        </div>

        <!-- รูป -->
        <div class="form-regis-group">
          <label>รูปโปรไฟล์</label>
          <input type="file" name="profile_pic" accept="image/*">
        </div>

        <!-- ปุ่ม -->
        <div class="modal-actions">
          <button type="submit" class="btn-submit">สมัคร</button>
          <button type="button" class="btn-cancel close-modal">ปิด</button>
        </div>

      </form>
    </div>
  </div>


<div id="forgetpassModal" class="modal hidden">
  <div class="modal-card">
    <h2 class="modal-title">ลืมรหัสผ่าน</h2>
    <p class="modal-subtitle">กรอกข้อมูลเพื่อยืนยันตัวตน</p>

    <form class="modal-form" id="forgotForm">
      <div class="form-regis-group">
        <label>Username</label>
        <input type="text" name="username" required>
      </div>

      <div class="form-regis-group">
        <label>เบอร์โทรศัพท์</label>
        <input type="text" name="phone" required>
      </div>

      <div class="form-regis-group">
        <label>อีเมล</label>
        <input type="email" name="email" required>
      </div>

      <div class="form-regis-group">
        <label>รหัสผ่านใหม่</label>
        <input type="password" name="new_password" required>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-cancel close-modal">ยกเลิก</button>
        <button type="submit" class="btn-submit">เปลี่ยนรหัสผ่าน</button>
      </div>
    </form>
  </div>
</div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/register.js"></script>
  <script src="/js/login.js"></script>
</body>

</html>