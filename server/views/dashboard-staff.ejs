<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>

  <link rel="stylesheet" href="css/layout.css">
  <link rel="stylesheet" href="css/component.css">
  <link rel="stylesheet" href="css/dashboard.css">
  <link rel="stylesheet" href="css/storage.css">
  <link rel="stylesheet" href="css/meat-info.css">


  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">

</head>

<body>

  <header>
    <div class="header-left">
      <img src="/image/project logo.png" class="logo logo-bg">
      <div>
        <h1>ระบบจัดการคลังชิ้นเนื้อโคขุน</h1>
        <div class="user-row">
          <div class="user-text">
            <div class="role-text" id="roleText">ผู้ใช้ : พนักงาน</div>
            <div class="role-logo-text role-logo" id="roleBadge">STAFF</div>
          </div>

          <img id="profileImage" class="role-pic">
        </div>
        </div>

        <div class="header-right">
          <button class="btn-add theme-font open-modal" data-target="insertmodal">
            <span class="icon">+</span> เพิ่มรายการ
          </button>

          <button id="logoutBtn" class="btn-logout theme-font">
            ออกจากระบบ
          </button>
        </div>

        <div id="insertmodal" class="modal hidden text-color-black">
          <div class="modal-card">
            <h3 class="modal-title ">เพิ่มรายการสินค้าคงคลัง</h3>
            <h2 class="modal-subtitle ">กรอกรายละเอียดของเนื้อวัวที่ต้องการเพิ่มเข้าสู่ระบบ</h2>

            <!-- หมายเลขรายการ -->
            <form class="modal-form">
              <div class="form-insert-group"><label>หมายเลขรายการ ( Lot Number )</label>
                <input type="text" placeholder="หมายเลขรายการ">
              </div>
            </form>

            <!-- ชนิดเนื้อ -->
            <form class="modal-form">
              <div class="form-insert-group"><label>ชนิดเนื้อ</label>
                <select>
                  <option value="">เลือกชนิดเนื้อ</option>
                </select>
              </div>
            </form>

            <!-- จำนวน / น้ำหนัก -->
            <div class="form-insert-row">
              <form>
                <div class="form-insert-group"><label>จำนวน ( ชิ้น )</label>
                  <input type="text">
                </div>
              </form>
              <form class="modal-form">
                <div class="form-insert-group"><label>น้ำหนัก ( กิโลกรัม )</label>
                  <input type="text">
                </div>
              </form>
            </div>

            <!-- สถานที่เก็บ -->
            <form class="modal-form">
              <div class="form-insert-group"><label>สถานที่เก็บ</label>
                <select>
                  <option value="">เลือกสถานที่เก็บ</option>
                </select>
              </div>
            </form>

            <!-- วันที่รับเข้า / วันหมดอายุ -->
            <div class="form-insert-row">
              <form>
                <div class="form-insert-group" style="flex:1;">
                  <label>วันที่รับเข้า</label>
                  <input type="date">
                </div>
              </form>
              <form class="modal-form">
                <div class="form-insert-group" style="flex:1;">
                  <label>วันหมดอายุ</label>
                  <input type="date">
                </div>
              </form>
            </div>

            <h3 class="modal-title-2">ข้อมูลเจ้าของชิ้นเนื้อ</h3>
            <h2 class="modal-subtitle ">กรอกรายละเอียดของเจ้าของชิ้นเนื้อ</h2>

            <!-- ชื่อเจ้าของชิ้นเนื้อ -->
            <form class="modal-form">
              <div class="form-insert-group"><label>ชื่อเจ้าของชิ้นเนื้อ</label>
                <input type="text" placeholder="กรอกชื่อผู้จัดจำหน่าย">
              </div>
            </form>

            <!-- เบอร์โทรศัพท์ / อีเมล -->
            <div class="form-insert-row">
              <form>
                <div class="form-insert-group"><label>เบอร์โทรศัพท์</label>
                  <input type="text" placeholder="0XX-XXX-XXXX">
                </div>
              </form>
              <form class="modal-form">
                <div class="form-insert-group"><label>อีเมล</label>
                  <input type="text" placeholder="example@email.com">
                </div>
              </form>
            </div>

            <!-- LINE ID / FACEBOOK -->
            <div class="form-insert-row">
              <form>
                <div class="form-insert-group"><label>LINE ID</label>
                  <input type="text" placeholder="@lineid">
                </div>
              </form>
              <form class="modal-form">
                <div class="form-insert-group"><label>FACEBOOK</label>
                  <input type="text" placeholder="facebook username">
                </div>
              </form>
            </div>

            <!-- หมายเลขสมาชิกสหกรณ์ -->
            <div class="form-insert-group">
              <label>หมายเลขสมาชิกสหกรณ์</label>
              <input type="text" placeholder="กรอกหมายเลขสมาชิกสหกรณ์">
            </div>

            <!-- สัญชาติ -->
            <div class="form-insert-group">
              <label>สัญชาติ</label>
              <input type="text">
            </div>

            <!-- ที่อยู่ -->
            <div class="form-insert-group">
              <label>ที่อยู่</label>
              <input type="text" placeholder="ที่อยู่">
            </div>

            <!-- เบอร์ / อีเมล -->
            <div class="form-insert-row">
              <div class="form-insert-group" style="flex:1;">
                <label>เบอร์โทรศัพท์</label>
                <input type="tel" placeholder="0XX-XXX-XXXX">
              </div>

              <div class="form-insert-group" style="flex:1;">
                <label>อีเมล</label>
                <input type="email" placeholder="example@email.com">
              </div>
            </div>

            <!-- เกรดคุณภาพ -->
            <div class="form-insert-group">
              <div class="form-insert-group"><label>เกรดคุณภาพ</label>
                <select>
                  <option value="">เลือกเกรดคุณภาพ</option>
                </select>
              </div>


              <!-- ปุ่ม -->
              <div class="modal-actions">
                <button type="submit" class="btn-submit">เพิ่มรายการ</button>
                <button type="button" id="closeRegister" class="btn-cancel close-modal">ปิด</button>
              </div>
            </div>
          </div>

  </header>

  <!-- เมนูด้านบน -->
  <nav class="menu menu-bg">
    <button class="active" data-page="stock"><img src="/image/Icon-box.png" class="icon">รายการชิ้นเนื้อคงคลัง</button>
    <button data-page="location"><img src="/image/Icon-store.png" class="icon">สถานที่จัดเก็บ</button>
    <button data-page="meat"><img src="/image/Icon-doc.png" class="icon">ข้อมูลชิ้นเนื้อ</button>
    <button data-page="history"><img src="/image/Icon-doc.png" class="icon">ประวัติการทำรายการ</button>
  </nav>



  <main>
    <!-- หน้ารายการชิ้นเนื้อ -->
    <section id="stock" class="page-1 page active">
      <div class="status-box">
        <div class="card">
          <div class="card-content">
            <h4>จำนวนชิ้นเนื้อภายในคลัง</h4>
            <h1 id="totalQty">0</h1>
            <span>ชิ้นในสต็อก</span>
          </div>
          <img src="/image/meat.png" class="card-icon">
        </div>

        <div class="card">
          <div class="card-content">
            <h4>น้ำหนักโดยรวม</h4>
            <h1 id="totalWeight">0</h1>
            <span>ทั้งหมดในคลัง</span>
          </div>
          <img src="/image/weight.png" class="card-icon-2">
        </div>

        <div class="card">
          <div class="card-content">
            <h4>รายการชิ้นเนื้อที่เหลือน้อย</h4>
            <h1 id="lowStockCount">0</h1>
            <span>รายการที่น้อยกว่า 10 ชิ้น</span>
          </div>
          <img src="/image/box.png" class="card-icon-3">
        </div>

        <div class="card">
          <div class="card-content">
            <h4>รายการชิ้นเนื้อที่ใกล้หมดอายุ</h4>
            <h1 id="nearExpireCount">0</h1>
            <span>รายการที่ใกล้หมดอายุแล้ว! ( 7 วัน )</span>
          </div>
          <img src="/image/warning.png" class="card-icon-4">
        </div>
      </div>

      <!-- 🔹 search -->
      <div class="search-box">
        <input type="text" class="theme-font" id="searchInput" placeholder="ค้นหารายการ..." />
      </div>

      <!-- 🔹 table -->
      <div class="table-box">
        <table>
          <thead class="dashboard-table">
            <tr>
              <th>หมายเลขรายการ</th>
              <th>ชนิดเนื้อ</th>
              <th>จำนวน</th>
              <th>น้ำหนัก (kg)</th>
              <th>สถานที่เก็บ</th>
              <th>เจ้าของชิ้นเนื้อ</th>
              <th>วันที่รับเข้า</th>
              <th>วันหมดอายุ</th>
              <th>สถานะการหมดอายุ</th>
              <th>เกรดคุณภาพ</th>
              <th>สถานะคลัง</th>
              <th>การจัดการ</th>
            </tr>
          </thead>
          <tbody id="stockTableBody"></tbody>
          <tr></tr>
        </table>
      </div>
    </section>

    <!-- หน้าสถานที่จัดเก็บ -->
    <section id="location" class="page-2 page">
      <div id="storageList" class="storage-box"></div>

      <!-- block รายการ (ซ่อนก่อน) -->
      <div id="storageDetail" class="storage-detail-block hidden">
        <h3 id="detailTitle"></h3>

        <table class="detail-table">
          <thead>
            <tr>
              <th>หมายเลขรายการ</th>
              <th>ชนิดเนื้อ</th>
              <th>จำนวน</th>
              <th>น้ำหนัก (kg)</th>
              <th>สถานที่</th>
              <th>เจ้าของชิ้นเนื้อ</th>
              <th>ระยะเวลาบ่ม</th>
              <th>เกรดคุณภาพ</th>
              <th>สถานะ</th>
            </tr>
          </thead>
          <tbody id="detailBody">
            <!-- JS ใส่ข้อมูล-->
          </tbody>
        </table>
      </div>
    </section>


    <!-- หน้าข้อมูลชิ้นเนื้อ -->
    <div class="content">
      <section id="meat" class="page-3 page">
        <div class="meat-info-card ">
          <div class="meat-search">
            <h2 class="meat-info-text">เลือกข้อมูลชิ้นเนื้อ</h2>
            <select id="meatSelect" class="theme-font">
              <option value="">-- เลือกรายการชิ้นเนื้อ --</option>
            </select>
          </div>
        </div>
        <div id="meatResult" class="meat-result hidden"></div>
      </section>
    </div>

    <section id="history" class="page inactive">
      <h2>ประวัติการทำรายการ</h2>
      <p>ประวัติการเพิ่ม / จ่าย / แก้ไข</p>
    </section>
  </main>

  <script src="/js/dashboard-staff.js"></script>
  <script type="module" src="/js/information.js"></script>
  <script type="module" src="/js/storage.js"></script>
  <script type="module" src="/js/dashboard-info.js"></script>
</body>

</html>